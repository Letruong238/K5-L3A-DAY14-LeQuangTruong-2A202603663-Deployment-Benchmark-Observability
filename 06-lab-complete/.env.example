# ============================================================
# Biến môi trường của agent (tiêu chí 9) — KHÔNG ghi secret thật ở đây.
# Dùng: cp .env.example .env   (file .env đã nằm trong .gitignore)
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Bảo mật — đặt một chuỗi ngẫu nhiên dài, vd: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Redis (state cho rate limit + cost guard). Trong docker compose được ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Giới hạn
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
